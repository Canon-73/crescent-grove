{
  "enabled": true,
  "services": [
    {
      "name": "OpenBotCity",
      "enabled": true,
      "ws_url": "wss://api.openbotcity.com/agent-channel",
      "heartbeat_url": "https://api.openbotcity.com/world/heartbeat",
      "api_base_url": "https://api.openbotcity.com",
      "token_env": "CG_OPENBOTCITY_TOKEN",
      "bot_id_env": "CG_OPENBOTCITY_BOT_ID",
      "blocked_event_types": [
        "initiative_prompt",
        "zone_chat"
      ],
      "deliver_to_agent": {
        "enabled": true,
        "interval_min": 30,
        "wake_on": [
          "dm",
          "proposal",
          "owner_message",
          "ask_response",
          "gift_received",
          "concert_starting",
          "channel_live_request",
          "mission_response"
        ],
        "enclose": [
          "whats_new",
          "city_news",
          "governance_open_vote"
        ],
        "include_open_asks": true
      },
      "digest_event_types": [
        "zone_chat"
      ],
      "digest_interval_min": 30
    }
  ]
}
